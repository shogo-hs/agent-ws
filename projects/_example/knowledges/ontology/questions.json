{
  "today": "2026-09-16",
  "questions": [
    {"id": "Q1", "question": "IdP 連携の担当は誰か",
     "kind": "query", "type": "Person",
     "where": "any('IdP' in w.name for w in leads)",
     "expect": {"ids": ["tanaka"]}},
    {"id": "Q2", "question": "IdP 連携が止まると影響を受ける顧客のシステムはどれか",
     "kind": "query", "type": "CustomerSystem",
     "where": "any('IdP' in w.name for w in affected_by)",
     "expect": {"ids": ["orders", "inventory", "billing"]}},
    {"id": "Q3", "question": "いま有効な台数の決定はどれか",
     "kind": "query", "type": "SizingDecision",
     "where": "status == 'active'",
     "expect": {"ids": ["SD-2"]}},
    {"id": "Q4", "question": "8 台のままで見積を出せるか",
     "kind": "action", "action": "IssueEstimate",
     "params": {"title": "運用の見積", "sizing": "SD-1", "items": "pi-node,pi-monitor", "months": "12", "approver": "sato"},
     "expect": {"status": "rejected",
                "messages": ["置き換え済みの決定（提案時の台数・8 台）を前提にしている。現行の決定は PoC の結果で見直した台数（12 台）"]}},
    {"id": "Q5", "question": "12 台・12 か月の見積は営業部長の決裁で出せるか",
     "kind": "action", "action": "IssueEstimate",
     "params": {"title": "運用の見積", "sizing": "SD-2", "items": "pi-node,pi-monitor", "months": "12", "approver": "sato"},
     "expect": {"status": "committed", "returned": {"nodes": 12, "monthly_yen": 410000, "total_yen": 4920000}}},
    {"id": "Q6", "question": "24 か月にすると誰の承認が要るか",
     "kind": "action", "action": "IssueEstimate",
     "params": {"title": "運用の見積（24 か月）", "sizing": "SD-2", "items": "pi-node,pi-monitor", "months": "24", "approver": "sato"},
     "expect": {"status": "staged"}},
    {"id": "Q7", "question": "期限の切れた単価で見積を出せるか",
     "kind": "action", "action": "IssueEstimate",
     "params": {"title": "運用の見積", "sizing": "SD-2", "items": "pi-node-old", "months": "12", "approver": "sato"},
     "expect": {"status": "rejected", "messages": ["有効期限の切れた単価が含まれている"]}},
    {"id": "Q8", "question": "技術部長の決裁で見積を出せるか",
     "kind": "action", "action": "IssueEstimate",
     "params": {"title": "運用の見積", "sizing": "SD-2", "items": "pi-node", "months": "12", "approver": "takahashi"},
     "expect": {"status": "rejected", "messages": ["高橋一郎 に見積の決裁権限が無い"]}},
    {"id": "Q9", "question": "完了した宿題をもう一度完了にできるか",
     "kind": "action",
     "given": [{"action": "CloseActionItem", "params": {"item": "A-1"}}],
     "action": "CloseActionItem", "params": {"item": "A-1"},
     "expect": {"status": "rejected", "messages": ["すでに完了している"]}},
    {"id": "Q10", "question": "誰が何をしたかが残っているか",
     "kind": "log",
     "given": [{"action": "IssueEstimate", "params": {"title": "運用の見積", "sizing": "SD-2", "items": "pi-node,pi-monitor", "months": "12", "approver": "sato"}},
               {"action": "IssueEstimate", "params": {"title": "運用の見積", "sizing": "SD-1", "items": "pi-node", "months": "12", "approver": "sato"}}],
     "expect": {"actions": ["IssueEstimate", "IssueEstimate"], "statuses": ["committed", "rejected"]}}
  ]
}
