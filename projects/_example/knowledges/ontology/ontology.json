{
  "ontology": "acme-migration",
  "version": 1,
  "description": "架空の顧客 ACME 社の業務システムを Kubernetes に移行する案件。決定・台数・単価・見積・宿題・担当。内容はすべて架空。",
  "governance": {"schema_changes": "stage"},
  "constants": {
    "MIN_CONTRACT_MONTHS": 1
  },
  "object_types": {
    "Stakeholder": {
      "label": "案件の関係者",
      "description": "顧客側・協力会社側の人。人の一種（自社の人は共通の Person に居る）。",
      "extends": ["Person"],
      "summary": ["name", "side", "role_in_project"],
      "properties": {
        "side": {"type": "enum", "values": ["customer", "partner"], "required": true, "label": "どちら側か"},
        "role_in_project": {"type": "string", "label": "案件での役割"},
        "phone": {"type": "string", "label": "電話", "agent_visible": false}
      }
    },
    "CustomerSystem": {
      "label": "顧客の業務システム",
      "label_property": "name",
      "summary": ["name"],
      "properties": {
        "name": {"type": "string", "required": true, "unique": true, "label": "名前"}
      }
    },
    "Workstream": {
      "label": "作業領域",
      "label_property": "name",
      "summary": ["name", "state"],
      "properties": {
        "name": {"type": "string", "required": true, "label": "名前"},
        "state": {"type": "enum", "values": ["not_started", "in_progress", "blocked", "done"], "required": true, "default": "not_started", "label": "状態"}
      }
    },
    "Decision": {
      "label": "決定",
      "description": "会議などで決まったこと。置き換えられたら status が superseded になり、新しい決定から supersedes で指される。",
      "label_property": "title",
      "summary": ["title", "decided_on", "status"],
      "properties": {
        "title": {"type": "string", "required": true, "label": "題"},
        "decided_on": {"type": "date", "required": true, "label": "決定日"},
        "status": {"type": "enum", "values": ["active", "superseded"], "required": true, "default": "active", "label": "状態"},
        "source": {"type": "string", "required": true, "label": "出所（references/ のパスか会議名と日付）"},
        "body": {"type": "text", "label": "内容"}
      }
    },
    "SizingDecision": {
      "label": "台数の決定",
      "description": "ノードの台数を決めた決定。見積はこれを前提にする。決定の一種。",
      "extends": ["Decision"],
      "summary": ["title", "nodes", "decided_on", "status"],
      "properties": {
        "nodes": {"type": "int", "required": true, "min": 1, "label": "ノードの台数"}
      }
    },
    "PriceItem": {
      "label": "単価",
      "label_property": "name",
      "summary": ["name", "unit_price_yen", "per_node", "valid_until"],
      "properties": {
        "name": {"type": "string", "required": true, "label": "名前"},
        "unit_price_yen": {"type": "int", "required": true, "min": 0, "label": "月額の単価（円）"},
        "per_node": {"type": "bool", "required": true, "default": false, "label": "ノード 1 台ごとに掛かるか"},
        "valid_until": {"type": "date", "label": "有効期限"}
      }
    },
    "Estimate": {
      "label": "見積",
      "label_property": "title",
      "summary": ["title", "nodes", "months", "monthly_yen", "total_yen"],
      "properties": {
        "title": {"type": "string", "required": true, "label": "題"},
        "nodes": {"type": "int", "required": true, "min": 1, "label": "ノードの台数"},
        "months": {"type": "int", "required": true, "min": 1, "label": "契約月数"},
        "monthly_yen": {"type": "int", "required": true, "min": 0, "label": "月額（円）"},
        "total_yen": {"type": "int", "required": true, "min": 0, "label": "総額（円）"}
      }
    },
    "Meeting": {
      "label": "会議",
      "label_property": "title",
      "summary": ["title", "held_on"],
      "properties": {
        "title": {"type": "string", "required": true, "label": "題"},
        "held_on": {"type": "date", "required": true, "label": "開催日"}
      }
    },
    "ActionItem": {
      "label": "宿題",
      "label_property": "title",
      "summary": ["title", "due_on", "state"],
      "properties": {
        "title": {"type": "string", "required": true, "label": "題"},
        "due_on": {"type": "date", "label": "期限"},
        "state": {"type": "enum", "values": ["open", "done"], "required": true, "default": "open", "label": "状態"}
      }
    }
  },
  "link_types": {
    "lead": {"label": "担当する人", "from": "Workstream", "to": "Person", "min": 1, "max": 1, "inverse": "leads", "inverse_label": "担当している作業領域"},
    "affects": {"label": "影響する", "from": "Workstream", "to": "CustomerSystem", "inverse": "affected_by", "inverse_label": "影響を受ける作業領域"},
    "supersedes": {"label": "置き換えた", "from": "Decision", "to": "Decision", "max": 1, "inverse": "superseded_by", "inverse_label": "置き換えた決定", "inverse_max": 1},
    "based_on": {"label": "前提にした台数の決定", "from": "Estimate", "to": "SizingDecision", "min": 1, "max": 1, "inverse": "estimates", "inverse_label": "これを前提にした見積"},
    "priced_by": {"label": "使った単価", "from": "Estimate", "to": "PriceItem", "min": 1, "inverse": "used_in", "inverse_label": "使われた見積"},
    "approver": {"label": "決裁する人", "from": "Estimate", "to": "Person", "min": 1, "max": 1, "inverse": "approves", "inverse_label": "決裁する見積"},
    "owner": {"label": "担当", "from": "ActionItem", "to": "Person", "min": 1, "max": 1, "inverse": "action_items", "inverse_label": "宿題"},
    "raised_in": {"label": "出た会議", "from": "ActionItem", "to": "Meeting", "max": 1, "inverse": "raised_items", "inverse_label": "出た宿題"}
  },
  "action_types": {
    "RecordSizingDecision": {
      "label": "台数の決定を記録する",
      "description": "ノードの台数についての決定を記録する。前の決定を置き換えるなら supersedes に指定すると、前の決定は superseded になる。出所（会議名と日付か references/ のパス）が無い決定は記録できない。",
      "parameters": {
        "title": {"type": "string", "required": true, "label": "題"},
        "nodes": {"type": "int", "required": true, "min": 1, "label": "ノードの台数"},
        "decided_on": {"type": "date", "required": true, "label": "決定日"},
        "source": {"type": "string", "required": true, "label": "出所"},
        "supersedes": {"object_type": "SizingDecision", "label": "置き換える決定"}
      },
      "criteria": [
        {"when": "days_since(decided_on) >= 0", "message": "決定日が未来になっている"},
        {"when": "supersedes is None or supersedes.status == 'active'", "message": "置き換える決定（{supersedes.title}）は既に置き換え済み。現行の決定は {supersedes.superseded_by.title}"}
      ],
      "rules": [
        {"create": "SizingDecision", "as": "decision", "id": "SD-{seq}",
         "set": {"title": "title", "nodes": "nodes", "decided_on": "decided_on", "source": "source", "status": "'active'"},
         "link": {"supersedes": "supersedes"}},
        {"modify": "supersedes", "if": "supersedes is not None", "set": {"status": "'superseded'"}}
      ],
      "approval": "auto",
      "returns": "decision",
      "next": "この台数を前提にした見積があれば出し直す（IssueEstimate sizing={decision.id}）。"
    },
    "IssueEstimate": {
      "label": "見積を出す",
      "description": "現行の台数の決定と単価から見積を作る。月額と総額はエンジンが計算するので、自分で計算した数字を書かない。置き換え済みの決定・期限の切れた単価・見積の決裁権限が無い人では出せない。総額が決裁する人の上限を超えると実行待ちに積まれ、人の承認で反映される。",
      "parameters": {
        "title": {"type": "string", "required": true, "label": "題"},
        "sizing": {"object_type": "SizingDecision", "required": true, "label": "前提にする台数の決定"},
        "items": {"object_type": "PriceItem", "required": true, "many": true, "label": "使う単価"},
        "months": {"type": "int", "required": true, "min": 1, "label": "契約月数"},
        "approver": {"object_type": "Person", "required": true, "label": "決裁する人"}
      },
      "criteria": [
        {"when": "sizing.status == 'active'", "message": "置き換え済みの決定（{sizing.title}・{sizing.nodes} 台）を前提にしている。現行の決定は {sizing.superseded_by.title}（{sizing.superseded_by.nodes} 台）"},
        {"when": "all(i.valid_until is None or days_since(i.valid_until) <= 0 for i in items)", "message": "有効期限の切れた単価が含まれている"},
        {"when": "any(a.kind == 'estimate' for a in approver.authorities)", "message": "{approver.name} に見積の決裁権限が無い"},
        {"when": "months >= MIN_CONTRACT_MONTHS", "message": "契約月数は {MIN_CONTRACT_MONTHS} か月以上"}
      ],
      "rules": [
        {"create": "Estimate", "as": "est", "id": "E-{seq}",
         "set": {"title": "title", "nodes": "sizing.nodes", "months": "months",
                 "monthly_yen": "sum(i.unit_price_yen * (sizing.nodes if i.per_node else 1) for i in items)",
                 "total_yen": "months * sum(i.unit_price_yen * (sizing.nodes if i.per_node else 1) for i in items)"},
         "link": {"based_on": "sizing", "priced_by": "items", "approver": "approver"}}
      ],
      "approval": {"stage_if": "not any(a.kind == 'estimate' and (a.limit_yen is None or est.total_yen <= a.limit_yen) for a in approver.authorities)", "role": "上位の決裁者"},
      "returns": "est",
      "next": "見積書の本文には {est.id} の値をそのまま使う（{est.nodes} 台・月額 {est.monthly_yen} 円・総額 {est.total_yen} 円）。計算し直さない。"
    },
    "AddActionItem": {
      "label": "宿題を足す",
      "description": "会議などで出た宿題を、担当と期限つきで記録する。担当は必ず 1 人。",
      "parameters": {
        "title": {"type": "string", "required": true, "label": "題"},
        "owner": {"object_type": "Person", "required": true, "label": "担当"},
        "due_on": {"type": "date", "label": "期限"},
        "meeting": {"object_type": "Meeting", "label": "出た会議"}
      },
      "rules": [
        {"create": "ActionItem", "as": "item", "id": "A-{seq}",
         "set": {"title": "title", "due_on": "due_on", "state": "'open'"},
         "link": {"owner": "owner", "raised_in": "meeting"}}
      ],
      "approval": "auto",
      "returns": "item"
    },
    "CloseActionItem": {
      "label": "宿題を完了にする",
      "description": "宿題を完了にする。すでに完了しているものには使えない。",
      "parameters": {
        "item": {"object_type": "ActionItem", "required": true, "label": "宿題"}
      },
      "criteria": [
        {"when": "item.state == 'open'", "message": "すでに完了している"}
      ],
      "rules": [
        {"modify": "item", "set": {"state": "'done'"}}
      ],
      "approval": "auto"
    }
  }
}
