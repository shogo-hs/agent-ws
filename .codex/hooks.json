{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/ws hook session-start",
            "timeout": 10,
            "statusMessage": "agent-ws: loading current task"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/ws hook pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
