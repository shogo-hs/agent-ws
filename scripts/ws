#!/usr/bin/env python3
"""ws — agent-ws の CLI。python3 の標準ライブラリだけで動く。

  scripts/ws --help            サブコマンド一覧
  scripts/ws task new A slug   タスクを作って現在のタスクにする
  scripts/ws hook ...          Claude Code / Codex CLI の hooks から呼ばれる

テストや別の場所からの利用では環境変数 WS_ROOT でリポジトリのルートを差し替えられる。
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import sys
import time
import urllib.parse
import urllib.request
from html.parser import HTMLParser
from pathlib import Path

ROOT = Path(os.environ.get("WS_ROOT") or Path(__file__).resolve().parent.parent).resolve()
PROJECTS = ROOT / "projects"
TEMPLATES = ROOT / "templates"
CURRENT = ROOT / ".ws" / "current"
IDX_BEGIN = "<!-- ws:index -->"
IDX_END = "<!-- /ws:index -->"
# projects/<案件>/tasks/<タスク> をツール入力のどこからでも拾う
TASK_RE = re.compile(r"projects/([^/\s\"'`<>]+)/tasks/([^/\s\"'`<>]+)")
# 「参照したナレッジ」の 1 行: - knowledges/<file>（updated YYYY-MM-DD）: 使った要点
KNOW_REF_RE = re.compile(r"^-\s*knowledges/(\S+?)（updated (\d{4}-\d{2}-\d{2})）", re.M)
LONG_TEXT = 10_000  # これを超える文字起こしは範囲を分けて読ませる
REF_KINDS = ("web", "file", "transcript", "chat", "person")
# reference の派生ファイル。ref add の付け替え・ref split の拒否・doctor のスキップがこれを見る。
# index は .orig.md だけ除外する（正規化版 .normalized.md と要点 .summary.md は次のセッションが使うので一覧に載せる）
DERIVED_SUFFIXES = (".orig.md", ".normalized.md", ".summary.md")
# 前回の応答からこの分数以上空いていたら、次の 1 通を止めて /clear を勧める
# （Claude サブスクリプションのプロンプトキャッシュ TTL は 60 分。API 直叩きは 5 分。Codex は 30 分）
# 優先順位: 環境変数 → hook の --ttl 引数 → 既定 60（cmd_hook_user_prompt_submit で解決する）。
# 未設定を区別するため None のまま持つ（int() で確定させない）。
CACHE_TTL_MIN_ENV = os.environ.get("WS_CACHE_TTL_MIN")
REPROMPT_GRACE_MIN = 10  # 止めたあと、この分数以内の再送は通す
SESSIONS = ROOT / ".ws" / "sessions"
LESSONS = ROOT / "LESSONS.md"  # 人からの指摘。1 行 1 件。hook が起動のたびに全行を差し込む
LESSONS_MAX = 20  # これを超えたら doctor が「減らせ」と報告する（長いほど守られない）
# SessionStart で注入する文字数の上限。hook の出力は 10,000 字で切られてファイル参照に化ける（Claude Code hooks リファレンス）
INJECT_MAX = 6_000
# tasks/ を横断してしまう一覧・検索のコマンド（Bash）。対象パスが projects / 案件直下 / tasks 直下なら hook が拒否する
SCAN_CMD_RE = re.compile(r"(?<![\w-])(find|ls|tree|grep|rg|cat|head|tail|wc|du)\b")


# ---- 小道具 ---------------------------------------------------------------

def now() -> dt.datetime:
    return dt.datetime.now().astimezone()


def today() -> str:
    return now().strftime("%Y-%m-%d")


def die(msg: str, code: int = 1):
    print(f"ws: {msg}", file=sys.stderr)
    sys.exit(code)


def rel(p: Path) -> str:
    return p.resolve().relative_to(ROOT).as_posix()


def render(template: Path, **kw) -> str:
    text = template.read_text(encoding="utf-8")
    for k, v in kw.items():
        text = text.replace("{{" + k + "}}", str(v))
    return text


def write(path: Path, text: str):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def slugify(s: str) -> str:
    s = re.sub(r"[\s/\\:*?\"<>|#]+", "_", s.strip())
    return s.strip("_") or "untitled"


def project_of(p: Path) -> str | None:
    parts = Path(rel(p)).parts
    return parts[1] if len(parts) >= 2 and parts[0] == "projects" else None


def project_dir(name: str) -> Path:
    p = PROJECTS / name
    if not p.is_dir():
        die(f"案件 {name} が無い。scripts/ws project new {name} で作る")
    return p


def _sess(sid: str, kind: str) -> Path:
    return SESSIONS / f"{sid}.{kind}"


def session_id() -> str | None:
    """エージェントの Bash から呼ばれた CLI が自分のセッションを知る手段。hook は stdin の session_id を使う。
    端末から叩くと None（.ws/current だけを見る）。Codex を先に見るのは、Claude Code の Bash から
    codex exec を起こすと両方の変数が見え、内側で動く hook は Codex の ID を持つため。"""
    return os.environ.get("CODEX_THREAD_ID") or os.environ.get("CLAUDE_CODE_SESSION_ID")


# ---- frontmatter（1階層の key: value だけ読む） ----------------------------

FM_RE = re.compile(r"^---\n(.*?)\n---\n?", re.S)


def read_frontmatter(path: Path) -> tuple[dict, str]:
    text = path.read_text(encoding="utf-8")
    m = FM_RE.match(text)
    if not m:
        return {}, text
    meta = {}
    for line in m.group(1).splitlines():
        if ":" in line and not line.startswith((" ", "\t", "#")):
            k, v = line.split(":", 1)
            meta[k.strip()] = v.strip().strip('"')
    return meta, text[m.end():]


def set_frontmatter(path: Path, **updates):
    text = path.read_text(encoding="utf-8")
    m = FM_RE.match(text)
    if not m:
        die(f"{rel(path)} に frontmatter が無い")
    lines = m.group(1).splitlines()
    for k, v in updates.items():
        for i, line in enumerate(lines):
            if line.split(":", 1)[0].strip() == k:
                lines[i] = f"{k}: {v}"
                break
        else:
            lines.append(f"{k}: {v}")
    write(path, "---\n" + "\n".join(lines) + "\n---\n" + text[m.end():])


# ---- index.md の自動生成部 -------------------------------------------------

def entry_line(md: Path, base: Path) -> str:
    meta, _ = read_frontmatter(md)
    r = md.relative_to(base).as_posix()
    label = r[: -len("index.md")] if r.endswith("/index.md") else r
    status = f" [{meta['status']}]" if meta.get("status") else ""
    title = meta.get("title", "")
    summary = meta.get("summary") or title
    return f"- [{label}]({r}){status}" + (f" — {summary}" if summary else "")


def index_entries(d: Path) -> list[str]:
    lines = []
    for p in sorted(d.iterdir()):
        if p.name.startswith("."):
            continue
        if p.is_file() and p.suffix == ".md" and p.name != "index.md" and not p.name.endswith(".orig.md"):
            lines.append(entry_line(p, d))
        elif p.is_dir() and p.name == "references":
            # タスクの index.md からは情報源を1段展開して直接見せる（読む回数を1回減らす）。
            # 原文ファイル（.orig.md）は一覧に出さない（要点ファイルだけで足りる）
            lines += [entry_line(q, d) for q in sorted(p.glob("*.md"))
                      if q.name != "index.md" and not q.name.endswith(".orig.md")]
        elif p.is_dir() and (p / "index.md").exists():
            lines.append(entry_line(p / "index.md", d))
    return lines


def update_index(d: Path) -> bool:
    idx = d / "index.md"
    if not idx.exists():
        return False
    text = idx.read_text(encoding="utf-8")
    if IDX_BEGIN not in text or IDX_END not in text:
        return False
    body = "\n".join(index_entries(d)) or "（まだ何もない）"
    pat = re.compile(re.escape(IDX_BEGIN) + r".*?" + re.escape(IDX_END), re.S)
    new = pat.sub(lambda _: f"{IDX_BEGIN}\n{body}\n{IDX_END}", text)
    if new != text:
        write(idx, new)
    return True


def cmd_index(args):
    if args.dir:
        targets = [Path(args.dir).resolve()]
    else:
        targets = [p.parent for p in PROJECTS.rglob("index.md")]
    n = sum(update_index(d) for d in targets)
    print(f"index.md を {n} 件更新した")


# ---- 案件・タスク ----------------------------------------------------------

def current_task(sid: str | None = None) -> Path | None:
    """現在のタスク。sid があればセッションの写し（.ws/sessions/<sid>.current）を優先し、
    写しが無ければ .ws/current を写してから使う。以後は他のセッションが .ws/current を書き換えても
    影響を受けない（同じ clone で 2 セッションを並行させたときの競合。issue #1）。"""
    src = CURRENT
    if sid:
        src = _sess(sid, "current")
        if not src.exists() and CURRENT.exists():
            SESSIONS.mkdir(parents=True, exist_ok=True)
            src.write_text(CURRENT.read_text(encoding="utf-8"), encoding="utf-8")
    text = src.read_text(encoding="utf-8").strip() if src.exists() else ""
    if not text:
        return None  # 無い、または task done 直後の空の写し（未設定）
    p = ROOT / text
    return p if (p / "index.md").exists() else None


def set_current(task_dir: Path, sid: str | None = None):
    CURRENT.parent.mkdir(exist_ok=True)
    CURRENT.write_text(rel(task_dir) + "\n", encoding="utf-8")
    if sid:
        SESSIONS.mkdir(parents=True, exist_ok=True)
        _sess(sid, "current").write_text(rel(task_dir) + "\n", encoding="utf-8")


def cmd_project_new(args):
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_-]*", args.name):
        die("案件名は英数字・ハイフン・アンダースコアだけ（パスに使うため）")
    p = PROJECTS / args.name
    if p.exists():
        die(f"{rel(p)} は既にある")
    src = TEMPLATES / "project"
    for tpl in src.rglob("*.md"):
        write(p / tpl.relative_to(src), render(tpl, project=args.name, date=today()))
    update_index(PROJECTS)
    print(f"作成: {rel(p)}\n次: {rel(p / 'index.md')} の「概要」を書く")


def cmd_task_new(args):
    proj = project_dir(args.project)
    d = proj / "tasks" / f"{now():%Y%m%d}_{slugify(args.slug)}"
    if d.exists():
        die(f"{rel(d)} は既にある。続けるなら scripts/ws task use {rel(d)}")
    title = args.title or args.slug
    write(d / "index.md", render(TEMPLATES / "task" / "index.md",
                                 title=title, project=args.project, date=today()))
    write(d / "references" / "index.md",
          render(TEMPLATES / "task" / "references" / "index.md", title=title))
    set_current(d, session_id())
    update_index(proj / "tasks")
    print(f"作成: {rel(d)}\n現在のタスクに設定した\n次: {rel(d / 'index.md')} の「目的」を書く")


def cmd_task_use(args):
    d = Path(args.path) if Path(args.path).is_absolute() else ROOT / args.path
    if not (d / "index.md").exists():
        die(f"{args.path} にタスクの index.md が無い")
    set_current(d, session_id())
    print(f"現在のタスク: {rel(d)}")


def cmd_task_current(args):
    t = current_task(session_id())
    if not t:
        print("現在のタスクは未設定（scripts/ws task new <project> <slug> か task use <path>）")
        sys.exit(1)
    meta, _ = read_frontmatter(t / "index.md")
    print(f"{rel(t)} [{meta.get('status', '?')}] {meta.get('title', '')}")


def cmd_task_done(args):
    sid = session_id()
    t = current_task(sid)
    if not t:
        die("現在のタスクが無い")
    set_frontmatter(t / "index.md", status="done", updated=today())
    if sid:
        # 空の写し = 未設定。消すと次の解決で .ws/current（他のセッションが最後に設定したタスク）を拾ってしまう
        SESSIONS.mkdir(parents=True, exist_ok=True)
        _sess(sid, "current").write_text("", encoding="utf-8")
    if CURRENT.exists() and CURRENT.read_text(encoding="utf-8").strip() == rel(t):
        CURRENT.unlink()  # 他のセッションが別のタスクに切り替えていたら、そちらは残す
    update_index(t.parent)
    print(f"完了: {rel(t)}（現在のタスクを解除した）")


# ---- 情報源 ----------------------------------------------------------------

class _TextExtractor(HTMLParser):
    """HTML から本文テキストだけを抜く。script/style/nav は捨てる。"""
    SKIP = {"script", "style", "noscript", "svg", "head", "nav", "footer"}
    BLOCK = {"p", "div", "br", "li", "h1", "h2", "h3", "h4", "h5", "h6", "tr",
             "section", "article", "pre", "blockquote", "table"}

    def __init__(self):
        super().__init__()
        self.parts: list[str] = []
        self.skip = 0
        self.title = ""
        self._in_title = False

    def handle_starttag(self, tag, attrs):
        if tag in self.SKIP:
            self.skip += 1
        if tag == "title":
            self._in_title = True
        if tag in self.BLOCK:
            self.parts.append("\n")

    def handle_endtag(self, tag):
        if tag in self.SKIP and self.skip:
            self.skip -= 1
        if tag == "title":
            self._in_title = False

    def handle_data(self, data):
        if self._in_title:
            self.title += data
        elif not self.skip:
            self.parts.append(data)

    def text(self) -> str:
        t = re.sub(r"[ \t　]+", " ", "".join(self.parts))
        return re.sub(r"\n\s*\n+", "\n\n", t).strip()


def _is_local_host(url: str) -> bool:
    """localhost・プライベート網の URL は r.jina.ai に投げても届かないので直接取得だけにする。"""
    host = urllib.parse.urlsplit(url).hostname or ""
    return host in ("localhost", "127.0.0.1", "::1") or bool(
        re.match(r"^10\.|^192\.168\.|^172\.(1[6-9]|2\d|3[01])\.", host))


def _fetch_direct(url: str) -> tuple[str, str]:
    req = urllib.request.Request(url, headers={"User-Agent": "agent-ws/0.1 (+scripts/ws ref add)"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            ctype = r.headers.get_content_type()
            charset = r.headers.get_content_charset() or "utf-8"
            body = r.read().decode(charset, errors="replace")
    except Exception as e:  # noqa: BLE001 — 取得失敗は理由を見せて止まるだけでよい
        die(f"取得に失敗: {url} ({e})")
    if "html" in ctype:
        p = _TextExtractor()
        p.feed(body)
        return p.title.strip(), p.text()
    return "", body


def fetch(url: str) -> tuple[str, str, str]:
    """本文を取る。r.jina.ai を第一選択にし、JS 描画・Cloudflare 保護のページでも本文を残す。
    500 バイト未満、または本文がエラー応答（error / {"code" で始まる）なら直接取得に落ちる。
    戻り値の経路（"jina" / "direct"）は reference の frontmatter に via として残す。
    """
    if not os.environ.get("WS_NO_JINA") and not _is_local_host(url):
        try:
            req = urllib.request.Request(f"https://r.jina.ai/{url}",
                                          headers={"User-Agent": "agent-ws/0.1 (+scripts/ws ref add)"})
            with urllib.request.urlopen(req, timeout=30) as r:
                raw = r.read()
            if len(raw) >= 500 and not raw.startswith((b"error", b'{"code"')):
                body = raw.decode("utf-8", errors="replace")
                first = body.split("\n", 1)[0]
                title = first[len("Title:"):].strip() if first.startswith("Title:") else ""
                return title, body, "jina"
        except Exception:  # noqa: BLE001 — jina が失敗したら直接取得へ
            pass
    title, body = _fetch_direct(url)
    return title, body, "direct"


def cmd_ref_add(args):
    if args.dir:
        dest_dir = Path(args.dir)
        dest_dir = dest_dir if dest_dir.is_absolute() else ROOT / dest_dir
        task = None
    else:
        task = current_task(session_id())
        if not task:
            die("現在のタスクが無い。scripts/ws task new か task use で設定するか --dir <path> を使う")
        dest_dir = task / "references"
    src = args.source
    via = "local"
    if re.match(r"https?://", src):
        if not args.force and (dup := _existing_ref(dest_dir, src)):
            print(f"既にある: {_shown(dup)}（source が同じ。読むならこのファイル、追記は「引用した記述」へ。撮り直すなら --force）")
            return
        title, body, via = fetch(src)
        kind = args.kind or "web"
    else:
        f = Path(src)
        if not f.is_file():
            die(f"{src} が無い")
        title, body = f.stem, f.read_text(encoding="utf-8", errors="replace")
        kind = args.kind or "file"
        src = rel(f) if f.resolve().is_relative_to(ROOT) else str(f.resolve())
        if not args.force and (dup := _existing_ref(dest_dir, src)):
            print(f"既にある: {_shown(dup)}（source が同じ。読むならこのファイル、追記は「引用した記述」へ。撮り直すなら --force）")
            return
    title = args.title or title or src
    dest = dest_dir / f"{now():%Y%m%d_%H%M}_{slugify(title)[:40]}.md"
    for suffix in DERIVED_SUFFIXES:  # 情報源が *.orig.md 等（スナップショットの原文など）でも要点側を派生扱いの名前にしない
        if dest.name.endswith(suffix):
            dest = dest.with_name(dest.name[: -len(suffix)] + "_" + suffix[1:-3] + ".md")
    if dest.exists():
        dest = dest.with_name(dest.stem + f"_{now():%S}.md")
    # 要点ファイル（frontmatter＋引用した記述＋使いどころ）と原文ファイル（.orig.md、frontmatter 無し）の対で保存する。
    # index には要点ファイルだけが載る（index_entries が .orig.md を除外）
    dest_orig = dest.with_name(dest.stem + ".orig.md")
    write(dest_orig, body)
    write(dest, render(TEMPLATES / "reference.md", title=title, kind=kind, source=src, via=via,
                       retrieved_at=now().isoformat(timespec="seconds"),
                       retrieved_by=os.environ.get("WS_AGENT", "unknown"),
                       summary=args.summary or "", orig_name=dest_orig.name))
    if task:
        update_index(task / "references")
        update_index(task)
    shown = rel(dest) if dest.resolve().is_relative_to(ROOT) else str(dest.resolve())
    shown_orig = rel(dest_orig) if dest_orig.resolve().is_relative_to(ROOT) else str(dest_orig.resolve())
    print(f"保存: {shown}")
    print(f"原文: {shown_orig}")
    if not args.summary:
        print("summary が空。読んだら summary・「引用した記述」・「このタスクでの使いどころ」を埋める")


# 原文節は要点ファイルの最後の節。本文（Web ページの Markdown）にも「## 見出し」が出るので、次の見出しで止めず末尾まで取る
_ORIG_SECTION_RE = re.compile(r"^##\s+原文（改変しない）\s*\n(.*)\Z", re.S | re.M)


def _shown(p: Path) -> str:
    """表示用のパス。ROOT の中なら相対、外（ref add --dir で外に置いたもの）なら絶対。"""
    return rel(p) if p.resolve().is_relative_to(ROOT) else str(p.resolve())


def _existing_ref(d: Path, source: str) -> Path | None:
    """同じ source を持つ reference の要点ファイル。同じページを 2 回撮って 2 回読むのを防ぐ（末尾の / と #fragment は無視）。"""
    key = source.rstrip("/").split("#", 1)[0]
    for p in sorted(d.glob("*.md")) if d.is_dir() else []:
        if p.name == "index.md" or p.name.endswith(DERIVED_SUFFIXES):
            continue
        if read_frontmatter(p)[0].get("source", "").rstrip("/").split("#", 1)[0] == key:
            return p
    return None


def cmd_ref_split(args):
    """旧形式（1 ファイルに原文まで書いた reference）を要点＋<stem>.orig.md の対に分割する。冪等。
    派生ファイル（.orig.md / .normalized.md / .summary.md）と、既に新形式の要点ファイルには手を付けない。"""
    f = Path(args.file)
    if not f.is_file():
        die(f"{args.file} が無い")
    if f.name.endswith(DERIVED_SUFFIXES):
        die(f"{_shown(f)} は派生ファイル。ref split は旧形式の reference（1 ファイル）にだけ使う")
    orig = f.with_name(f.stem + ".orig.md")
    if orig.is_file():
        print(f"済: {_shown(f)} は既に分割済み（{_shown(orig)}）")
        return
    text = f.read_text(encoding="utf-8")
    m = _ORIG_SECTION_RE.search(text)
    raw = m.group(1).lstrip("\n") if m else ""
    if raw.lstrip().startswith("原文: "):
        print(f"済: {_shown(f)} は既に新形式（.orig.md が無いので原文は失われている。source から ref add で撮り直す）")
        return
    if not raw.strip():
        print(f"{_shown(f)}: 「原文（改変しない）」節が空。何もしない")
        return
    write(orig, raw)
    pointer = f"原文: [{orig.name}]({orig.name})（改変しない。文字起こしなら正規化版 *.normalized.md を読む）\n\n"
    new_text = text[:m.start(1)] + pointer + text[m.end(1):]
    f.write_text(new_text, encoding="utf-8")
    print(f"分割: {_shown(f)} / 原文: {_shown(orig)}")
    if f.parent.name == "references":
        update_index(f.parent)
        update_index(f.parent.parent)


# ---- 用語集と文字起こし ----------------------------------------------------

def load_glossary(proj: Path) -> list[tuple[str, str]]:
    """glossary.md の表から (誤変換, 正式表記) の組を長い順に返す。"""
    g = proj / "knowledges" / "glossary.md"
    if not g.exists():
        return []
    pairs = []
    for line in g.read_text(encoding="utf-8").splitlines():
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) < 3 or cells[0] in ("", "正式表記") or set(cells[0]) <= set("-: "):
            continue
        term = cells[0]
        for alias in re.split(r"[,、，]", cells[2]):
            alias = alias.strip()
            if len(alias) >= 2 and alias != term:
                pairs.append((alias, term))
    # ponytail: 長い順に単純置換。連鎖置換（置換結果が別の誤変換に一致）は用語集側で避ける
    pairs.sort(key=lambda p: -len(p[0]))
    return pairs


def cmd_transcript_normalize(args):
    f = Path(args.file)
    if not f.is_file():
        die(f"{args.file} が無い")
    cur = current_task(session_id())
    name = args.project or project_of(f) or (project_of(cur) if cur else None)
    if not name:
        die("案件が分からない。--project <name> を付ける")
    pairs = load_glossary(project_dir(name))
    # 新形式（要点ファイル）が渡されたら隣の .orig.md を読む。.orig.md 自体を渡されても、
    # 旧形式（1 ファイル）を渡されても出力名は <stem>.normalized.md のまま
    stem = f.name[: -len(".orig.md")] if f.name.endswith(".orig.md") else f.stem
    orig = f.with_name(stem + ".orig.md")
    src_file = orig if orig.is_file() else f
    text = src_file.read_text(encoding="utf-8", errors="replace")
    counts: dict[tuple[str, str], int] = {}
    for alias, term in pairs:
        n = text.count(alias)
        if n:
            text = text.replace(alias, term)
            counts[(alias, term)] = n
    out = f.with_name(stem + ".normalized.md")
    write(out, text)
    shown = rel(out) if out.resolve().is_relative_to(ROOT) else str(out)
    print(f"出力: {shown}（{len(text):,} 文字・{text.count(chr(10)) + 1:,} 行）")
    if len(text) > LONG_TEXT:
        print(f"  {LONG_TEXT:,} 文字を超えている。丸ごと読まず、時刻や見出しの区切りで範囲を分けて読む"
              f"（例: sed -n '1,200p' {shown}）")
    if not counts:
        print("  置換なし（用語集に一致する誤変換が無い。用語集: "
              f"projects/{name}/knowledges/glossary.md）")
    for (alias, term), n in counts.items():
        print(f"  {alias} → {term}: {n}")


def cmd_glossary_add(args):
    proj = project_dir(args.project)
    g = proj / "knowledges" / "glossary.md"
    if not g.exists():
        write(g, render(TEMPLATES / "project" / "knowledges" / "glossary.md",
                        project=args.project, date=today()))
    cell = lambda s: (s or "").replace("|", "／").strip()  # noqa: E731
    row = f"| {cell(args.term)} | {cell(args.reading)} | {cell(args.alias)} | {cell(args.desc)} |"
    write(g, g.read_text(encoding="utf-8").rstrip("\n") + "\n" + row + "\n")
    update_index(proj / "knowledges")
    print(f"追加: {row}")


def cmd_know_new(args):
    proj = project_dir(args.project)
    kd = proj / "knowledges"
    nums = [int(m.group(1)) for p in kd.glob("*.md") if (m := re.match(r"(\d{3})_", p.name))]
    dest = kd / f"{max(nums, default=0) + 1:03d}_{slugify(args.title)}.md"
    write(dest, render(TEMPLATES / "knowledge.md", title=args.title, date=today()))
    update_index(kd)
    print(f"作成: {rel(dest)}\n次: 内容・出所・frontmatter の summary と type を書く")


# ---- 教訓（人からの指摘） ---------------------------------------------------

LESSONS_HEAD = ("# LESSONS — 人からの指摘\n"
                "（1 指摘 1 行「- 〜のとき、〜する（理由）」。`scripts/ws lesson add` で足す。"
                f"{LESSONS_MAX} 行を超えたら統合するか AGENTS.md・doctor の検査へ昇格して減らす）\n\n")


def lesson_lines() -> list[str]:
    if not LESSONS.exists():
        return []
    return [l for l in LESSONS.read_text(encoding="utf-8").splitlines() if l.startswith("- ")]


def _append_to_section(path: Path, name: str, line: str) -> bool:
    """index.md の「## name」節の末尾に line を足す。雛形の括弧書きは消す。既にあれば False。"""
    text = path.read_text(encoding="utf-8")
    m = re.search(rf"^##\s+{re.escape(name)}\s*\n(.*?)(?=^##\s|\Z)", text, re.S | re.M)
    if not m:
        die(f"{rel(path)} に「{name}」の節が無い")
    kept = [l for l in m.group(1).splitlines() if l.strip() and not (l.startswith("（") and l.endswith("）"))]
    if line in kept:
        return False
    body = "\n".join(kept + [line]) + "\n\n"
    path.write_text(text[:m.start(1)] + body + text[m.end(1):], encoding="utf-8")
    return True


def cmd_lesson_add(args):
    line = "- " + " ".join(args.text.split())
    if args.project:
        idx = project_dir(args.project) / "index.md"
        if not _append_to_section(idx, "この案件での決まりごと", line):
            print(f"既にある: {rel(idx)}")
            return
        print(f"追加: {rel(idx)} の「この案件での決まりごと」")
        return
    if line in lesson_lines():
        print("既にある: LESSONS.md")
        return
    if not LESSONS.exists():
        LESSONS.write_text(LESSONS_HEAD, encoding="utf-8")
    with LESSONS.open("a", encoding="utf-8") as f:
        f.write(line + "\n")
    n = len(lesson_lines())
    print(f"追加: LESSONS.md（{n} 行）")
    if n > LESSONS_MAX:
        print(f"{LESSONS_MAX} 行を超えた。統合するか AGENTS.md・doctor の検査へ昇格して減らす")


# ---- 点検 ------------------------------------------------------------------

def cmd_doctor(args):
    problems: list[str] = []
    if not PROJECTS.is_dir():
        die("projects/ が無い")
    if len(lesson_lines()) > LESSONS_MAX:
        problems.append(f"LESSONS.md が {len(lesson_lines())} 行（上限 {LESSONS_MAX}）。"
                        "統合するか AGENTS.md・doctor の検査へ昇格して減らす")
    for proj in sorted(p for p in PROJECTS.iterdir() if p.is_dir()):
        for req in ("index.md", "knowledges/index.md", "tasks/index.md"):
            if not (proj / req).exists():
                problems.append(f"{rel(proj)}/{req} が無い")
        for k in (proj / "knowledges").glob("*.md") if (proj / "knowledges").is_dir() else []:
            if k.name != "index.md" and not read_frontmatter(k)[0].get("summary"):
                problems.append(f"{rel(k)}: frontmatter の summary が空")
        tasks = proj / "tasks"
        for t in sorted(p for p in tasks.iterdir() if p.is_dir()) if tasks.is_dir() else []:
            idx = t / "index.md"
            if not idx.exists():
                problems.append(f"{rel(t)}/index.md が無い")
                continue
            meta, body = read_frontmatter(idx)
            if not meta.get("status"):
                problems.append(f"{rel(idx)}: frontmatter の status が無い")
            refs = t / "references"
            if not refs.is_dir():
                problems.append(f"{rel(t)}/references/ が無い")
            elif meta.get("status") == "doing" and not [p for p in refs.glob("*.md") if p.name != "index.md"]:
                problems.append(f"{rel(t)}: references/ が空（情報源を記録していない）")
            if meta.get("status") != "doing":
                continue
            for rf in (refs.glob("*.md") if refs.is_dir() else []):
                if rf.name == "index.md" or rf.name.endswith(DERIVED_SUFFIXES):
                    continue
                rmeta, rbody = read_frontmatter(rf)
                raw_orig_section = _section_raw(rbody, "原文（改変しない）").strip()
                orig = rf.with_name(rf.stem + ".orig.md")
                has_orig = orig.is_file() and orig.stat().st_size > 0
                # 新形式は「原文（改変しない）」節が常にポインタ行（空にならない）なので、
                # ポインタ行かどうかで新旧を見分ける。旧形式は原文そのものが入っている
                is_old_format_body = bool(raw_orig_section) and not raw_orig_section.startswith("原文: ")
                if not has_orig and not is_old_format_body:
                    problems.append(f"{rel(rf)}: 原文が無い（.orig.md も原文節も空）")
                quote = _section_raw(rbody, "引用した記述（原文のまま。要約しない）").strip()
                if not quote or (quote.startswith("（") and quote.endswith("）")):
                    problems.append(f"{rel(rf)}: 「引用した記述」節が未記入のまま")
                if not rmeta.get("summary"):
                    problems.append(f"{rel(rf)}: frontmatter の summary が空")
            for kfile, ref_date in KNOW_REF_RE.findall(_section_raw(body, "参照したナレッジ")):
                kpath = proj / "knowledges" / kfile
                actual = read_frontmatter(kpath)[0].get("updated") if kpath.exists() else None
                if actual and actual > ref_date:
                    problems.append(f"{rel(idx)}: 参照したナレッジ knowledges/{kfile} は記録（updated {ref_date}）"
                                     f"より新しい（参照後に更新された。現在 updated {actual}）")
    for p in problems:
        print("- " + p)
    print("問題なし" if not problems else f"{len(problems)} 件")
    sys.exit(1 if problems else 0)


# ---- hooks（Claude Code / Codex CLI 共通） ---------------------------------

def _stdin_json() -> dict:
    try:
        return json.loads(sys.stdin.read() or "{}")
    except Exception:  # noqa: BLE001
        return {}


def _section_raw(body: str, name: str) -> str:
    """「## name」節の生テキスト（改行つき）。無ければ空文字。"""
    m = re.search(rf"^##\s+{re.escape(name)}\s*\n(.*?)(?=^##\s|\Z)", body, re.S | re.M)
    return m.group(1) if m else ""


def _section(body: str, name: str, limit: int = 300) -> str:
    text = " ".join(_section_raw(body, name).split())
    return text[:limit] if text else "（未記入）"


def _mark_stop(sid: str):
    SESSIONS.mkdir(parents=True, exist_ok=True)
    _sess(sid, "last_stop").write_text(str(int(time.time())), encoding="utf-8")


def cmd_hook_stop(args):
    """応答が終わった時刻を記録する。キャッシュのタイマーはここから数える。"""
    sid = _stdin_json().get("session_id")
    if sid:
        _mark_stop(sid)


def cmd_hook_user_prompt_submit(args):
    """前回の応答から TTL 以上空いていたら、この 1 通を送らずに止める。

    TTL は環境変数 WS_CACHE_TTL_MIN があればそれ、無ければ --ttl、それも無ければ 60 分
    （Codex は .codex/hooks.json から --ttl 30 を渡す。Claude サブスクリプションは既定 60 分）。
    止めると会話全文の再処理（キャッシュ切れ）が起きない。人は /clear して index.md から
    再開するか、同じ内容をもう一度送る（REPROMPT_GRACE_MIN 以内なら通す）。
    """
    ttl_min = int(CACHE_TTL_MIN_ENV) if CACHE_TTL_MIN_ENV else (args.ttl if args.ttl is not None else 60)
    data = _stdin_json()
    sid = data.get("session_id")
    if not sid or not _sess(sid, "last_stop").exists():
        return
    gap_min = (time.time() - int(_sess(sid, "last_stop").read_text().strip() or 0)) / 60
    if gap_min < ttl_min:
        return
    warned = _sess(sid, "warned")
    if warned.exists() and time.time() - warned.stat().st_mtime < REPROMPT_GRACE_MIN * 60:
        warned.unlink()  # 人が承知の上で送り直した
        return
    warned.write_text(str(int(time.time())), encoding="utf-8")
    saved = _sess(sid, "blocked_prompt")
    saved.write_text(data.get("prompt") or data.get("user_input") or "", encoding="utf-8")
    cur = current_task(sid)
    where = f"現在のタスクは {rel(cur)}（index.md に現在地と次の一手）" if cur else "現在のタスクは未設定"
    print(f"[agent-ws] 前回の応答から {gap_min:.0f} 分空いています。プロンプトキャッシュ（{ttl_min} 分）は"
          "切れているので、この会話に続きを送ると会話全文を定価で再処理します。\n"
          f"安く済ませるなら /clear して index.md から再開してください。{where}。\n"
          f"それでも続けるなら、同じ内容を {REPROMPT_GRACE_MIN} 分以内にもう一度送れば通します"
          f"（本文は {rel(saved)} に保存しました）。", file=sys.stderr)
    sys.exit(2)


def _emit_context(text: str) -> None:
    """起動時の案内をモデルの文脈に足す。Claude Code は素のテキストでも JSON でも拾うが、
    Codex は JSON の additionalContext しか拾わない（0.153.4 で実測）ので JSON で出す。"""
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart",
                                             "additionalContext": text}}, ensure_ascii=False))


def cmd_hook_session_start(args):
    data = _stdin_json()
    sid, source = data.get("session_id"), data.get("source", "")
    if sid:
        SESSIONS.mkdir(parents=True, exist_ok=True)
        if source in ("startup", "clear"):
            # current も捨てる: 新しいセッションは最後に設定したタスク（.ws/current）から始める
            for kind in ("last_stop", "warned", "blocked_prompt", "current"):
                _sess(sid, kind).unlink(missing_ok=True)
        elif source == "compact":
            _mark_stop(sid)  # 要約のリクエストが今飛んだので、タイマーはここから
        cutoff = time.time() - 7 * 86400
        for f in SESSIONS.iterdir():
            if f.stat().st_mtime < cutoff:
                f.unlink(missing_ok=True)
    lessons = lesson_lines()
    tail = "\n人からの指摘（LESSONS.md。守る）:\n" + ("\n".join(lessons) if lessons else "（無し）")
    t = current_task(sid)
    if not t:
        _emit_context("[agent-ws] 現在のタスクは未設定。着手するときは task-start スキル"
              "（scripts/ws task new <project> <slug>）。案件一覧は projects/index.md。" + tail)
        return
    meta, body = read_frontmatter(t / "index.md")
    proj = project_of(t)
    # 案件の index.md の「この案件での決まりごと」は書く場所だけあって読む導線が無かったので、ここで差し込む。
    # ponytail: 600 字で切る。超える案件が実際に出たら knowledges/ へ移す案内を doctor に足す
    pidx = PROJECTS / str(proj) / "index.md"
    rules = _section(read_frontmatter(pidx)[1] if pidx.exists() else "", "この案件での決まりごと", 600)
    head = (f"[agent-ws] 現在のタスク: {rel(t)}（{meta.get('title', '')} / {meta.get('status', '')}）\n"
            "他の tasks/ 配下は読まない（hook が拒否する）。\n"
            f"この案件での決まりごと（projects/{proj}/index.md より）: {rules}\n")
    # index.md の全文とナレッジの一覧をここで渡し、Read で読み直す 1〜2 ターン分の文脈の払い直しを省く
    # （ターンごとに会話全体を再送する。bench では 1 ターン ≒ 32k トークンの cache read）。
    # compact 後も SessionStart(compact) で同じものが入る。長すぎるときは従来どおりパスだけ示す
    know = _index_block(PROJECTS / str(proj) / "knowledges" / "index.md")
    full = (head + f"ナレッジの一覧（projects/{proj}/knowledges/index.md より。必要なものだけ開く）:\n{know}\n"
            f"--- {rel(t)}/index.md の全文（Read で読み直さない。更新は Edit で）---\n{body.strip()}\n---")
    if len(full) + len(tail) <= INJECT_MAX:
        _emit_context(full + tail)
        return
    _emit_context(head + f"まず {rel(t)}/index.md を読む。ナレッジは projects/{proj}/knowledges/index.md から必要なものだけ開く。\n"
                  f"次の一手（index.md より）: {_section(body, '次の一手')}" + tail)


def _index_block(idx: Path) -> str:
    """index.md の自動生成部（<!-- ws:index --> の中）の行。無ければ（無し）。"""
    if not idx.exists():
        return "（無し）"
    m = re.search(re.escape(IDX_BEGIN) + r"\n?(.*?)" + re.escape(IDX_END), idx.read_text(encoding="utf-8"), re.S)
    return (m.group(1).strip() if m else "") or "（無し）"


def _deny(reason: str):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
    }}, ensure_ascii=False))


def _ref_add_reason(url: str, tool_label: str) -> str:
    return (f'[agent-ws] Web ページは{tool_label}で読まない（要約しか返らず原文が残らない）。'
            f'代わりに次を実行して、保存されたファイルを読む: scripts/ws ref add {url} --summary "<1 文>"'
            "（読んだら「引用した記述」「使いどころ」「summary」を埋める）")


def _normalized_for(path_str: str) -> Path | None:
    """path_str が文字起こしの原文で、正規化版があるならそのパスを返す（無ければ None）。
    誤変換に引きずられないよう、原文ではなく正規化版を読ませるための読み替え先。"""
    p = Path(path_str)
    if not p.is_absolute():
        p = ROOT / p
    if p.name.endswith(".normalized.md"):
        return None
    if p.name.endswith(".orig.md"):
        stem = p.name[: -len(".orig.md")]
    else:
        stem = p.stem
        if p.with_name(stem + ".orig.md").is_file():
            return None  # 新形式の要点ファイル（小さいので読ませてよい）
    norm = p.with_name(stem + ".normalized.md")
    return norm if norm.is_file() else None


def _scan_roots(tool: str, tool_input: dict) -> list[str]:
    """tasks/ を横断してしまう一覧・検索の対象（projects / projects/<案件> / projects/<案件>/tasks、未指定＝ルート）を返す。
    Grep/Glob は path、Bash は find/ls/grep/rg 等の引数を見る。他タスクの本文が結果に混ざるのを防ぐ。"""
    if tool in ("Grep", "Glob"):
        cands = [tool_input.get("path") or "."]
    elif tool in ("Bash", "shell"):
        cmd = tool_input.get("command", "")
        if not SCAN_CMD_RE.search(cmd):
            return []
        cands = re.findall(r"(?<=\s)(?:\S*/)?projects(?:/[^/\s'\"`;|&]+){0,2}/?(?=[\s'\"`;|&]|$)", cmd)
        if re.search(r"\b(?:find|rg|tree|grep\s+-\w*r\w*)\b[^|;&]*\s\.(?:\s|$)", cmd) and not TASK_RE.search(cmd):
            cands.append(".")
    else:
        return []
    hit = []
    for c in cands:
        r = str(c).replace(str(ROOT) + "/", "").replace(str(ROOT), ".").rstrip("/") or "."
        parts = r.split("/")
        if len(parts) > 1 and "." in parts[-1]:
            continue  # projects/index.md のようなファイル（一覧を読むのは正しい導線）
        if r == "." or parts == ["projects"] or (len(parts) == 2 and parts[0] == "projects") or (
                len(parts) == 3 and parts[0] == "projects" and parts[2] == "tasks"):
            hit.append(r)
    return hit


def cmd_hook_pre_tool_use(args):
    data = _stdin_json()
    tool = data.get("tool_name", "")
    sid = data.get("session_id")
    tool_input = data.get("tool_input", {})
    blob = json.dumps(tool_input, ensure_ascii=False)
    if tool in ("Bash", "shell") and "scripts/ws" in blob:
        m = sid and re.search(r"\btask\s+(use|new|done)\b", blob)
        if m:
            # 切り替え・完了の相手は .ws/current。CLI が環境変数でセッションを知らない場合に備えて
            # 写しを捨て、CLI か次の hook が写し直す。done は写しの内容を先に .ws/current へ戻す
            copy = _sess(sid, "current")
            if m.group(1) == "done" and copy.exists() and copy.read_text(encoding="utf-8").strip():
                CURRENT.write_text(copy.read_text(encoding="utf-8"), encoding="utf-8")
            copy.unlink(missing_ok=True)
        return  # ws 自身によるタスク操作は通す
    cur = current_task(sid)
    if cur and tool == "WebFetch":
        _deny(_ref_add_reason(tool_input.get("url", ""), "WebFetch"))
        return
    if cur and tool in ("Bash", "shell"):
        cmd = tool_input.get("command", "")
        if re.search(r"\b(curl|wget)\b", cmd):
            m = re.search(r"https?://[^\s'\"]+", cmd)
            if m and not _is_local_host(m.group(0)):
                _deny(_ref_add_reason(m.group(0), "curl/wget"))
                return
    # bench/ は計測用の架空の案件。仕事中（現在のタスクがある間）に読むと実案件と混ざり、トークンも無駄になる。
    # ROOT からの相対で見る（/var/tmp/agent-ws-bench/ のような外のパスには当てない）
    if re.search(r"(?<![\w.-])bench/", blob.replace(str(ROOT) + "/", "")) and cur:
        _deny("[agent-ws] bench/ は計測用の架空の材料（案件・タスク・資料）。仕事では読まない。"
              "agent-ws 自体を直すために要るなら scripts/ws task done で現在のタスクを外してから。")
        return
    # docs/snapshots/ は agent-ws 自体の規則の根拠（Web ページの原文、数十 KB〜）。案件の仕事で grep が当たると丸ごと読んでしまう
    if re.search(r"(?<![\w.-])docs/snapshots(?![\w.-])", blob.replace(str(ROOT) + "/", "")) and cur:
        _deny("[agent-ws] docs/snapshots/ は agent-ws 自体の規則の根拠（Web ページの原文）。案件の仕事では読まない"
              "（台帳は docs/sources/）。agent-ws 自体を直すために要るなら scripts/ws task done で現在のタスクを外してから。")
        return
    cur_key = tuple(Path(rel(cur)).parts[1:4:2]) if cur else None  # (案件, タスク)
    hits = {(p, t) for p, t in TASK_RE.findall(blob) if t != "index.md"}
    if hits:
        others = sorted(f"projects/{p}/tasks/{t}" for p, t in hits if (p, t) != cur_key)
        if others:
            if cur:
                reason = (f"[agent-ws] 現在のタスク（{rel(cur)}）以外のタスクフォルダにはアクセスしない: "
                          f"{', '.join(others)}\n"
                          f"ナレッジの正本は projects/{cur_key[0]}/knowledges/（入口は knowledges/index.md）。"
                          "そこに無ければ knowledge-promote で昇格するか、人に聞く。"
                          f"タスクを切り替えるなら scripts/ws task use {others[0]}。")
            else:
                reason = (f"[agent-ws] 現在のタスクが未設定のまま tasks/ 配下にアクセスしない: {', '.join(others)}\n"
                          "着手するには scripts/ws task new <project> <slug>（新規）か "
                          f"scripts/ws task use {others[0]}（既存）。")
            _deny(reason)
            return
    if cur:
        roots = _scan_roots(tool, tool_input)
        if roots:
            _deny(f"[agent-ws] {', '.join(roots)} を横断して一覧・検索しない（他タスクの本文が結果に混ざり、トークンも無駄になる）。"
                  f"一覧は projects/index.md と projects/{cur_key[0]}/tasks/index.md。検索は現在のタスク（{rel(cur)}）か "
                  f"projects/{cur_key[0]}/knowledges/ に範囲を絞る。")
            return
    # ここまで来たら他タスクへのアクセスではない。正規化版があるならそちらへ読み替える
    # （誤変換の残る原文を読ませない。順序はここが最後＝上の deny 判定を全部通ったあとに評価する）
    if tool in ("Read", "Grep"):
        key = "file_path" if tool == "Read" else "path"  # Grep はディレクトリ指定なら対象外（_normalized_for が None）
        norm = _normalized_for(tool_input.get(key) or "")
        if norm:
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "allow",
                "updatedInput": {**tool_input, key: str(norm)},
            }}, ensure_ascii=False))
    elif tool in ("Bash", "shell"):
        for m in re.finditer(r"[^\s'\"]+\.md", tool_input.get("command", "")):
            norm = _normalized_for(m.group(0))
            if norm:
                shown = rel(norm) if norm.resolve().is_relative_to(ROOT) else str(norm)
                _deny(f"[agent-ws] 正規化前の文字起こしは読まない（誤変換に引きずられる）。正規化版を読む: {shown}")
                return


def cmd_statusline(args):
    """Claude Code の statusLine から呼ばれる（.claude/settings.json）。stdin の JSON を 1 行にする。
    現在のタスク・文脈の使用率・このセッションの費用（定価）を常時見せ、/clear や compact の頃合いを人が判断できるようにする。
    費用と使用率は Claude Code が渡す値をそのまま出す（自分では数えない）。"""
    d = _stdin_json()
    t = current_task(d.get("session_id"))
    cw, cost = d.get("context_window") or {}, d.get("cost") or {}
    pct = cw.get("used_percentage")
    parts = [f"agent-ws {Path(rel(t)).name if t else '（タスク未設定）'}",
             (d.get("model") or {}).get("display_name", ""),
             f"ctx {pct:.0f}%" if isinstance(pct, (int, float)) else "ctx -",
             f"${(cost.get('total_cost_usd') or 0):.2f}"]
    print(" | ".join(p for p in parts if p))


def cmd_hook_post_tool_use(args):
    """WebSearch の結果 URL を文脈に足す。読むなら ref add へ誘導する（WebFetch は pre-tool-use が止める）。"""
    data = _stdin_json()
    if data.get("tool_name") != "WebSearch" or not current_task(data.get("session_id")):
        return
    urls: list[str] = []
    for item in (data.get("tool_response") or {}).get("results") or []:
        if not isinstance(item, dict):
            continue
        for c in item.get("content") or []:
            if isinstance(c, dict) and c.get("url"):
                urls.append(c["url"])
            if len(urls) >= 10:
                break
        if len(urls) >= 10:
            break
    if not urls:
        return
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PostToolUse",
        "additionalContext": "[agent-ws] 検索結果のページを読むなら scripts/ws ref add <URL> で（WebFetch は止まる）。"
                              f"候補: {', '.join(urls)}",
    }}, ensure_ascii=False))


# ---- 引数 ------------------------------------------------------------------

def main(argv=None):
    ap = argparse.ArgumentParser(prog="scripts/ws", description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("project", help="案件").add_subparsers(dest="sub", required=True)
    q = p.add_parser("new", help="案件フォルダを雛形から作る")
    q.add_argument("name")
    q.set_defaults(fn=cmd_project_new)

    t = sub.add_parser("task", help="タスク").add_subparsers(dest="sub", required=True)
    q = t.add_parser("new", help="タスクフォルダを作り、現在のタスクにする")
    q.add_argument("project")
    q.add_argument("slug", help="英数字の短い名前。フォルダ名は yyyymmdd_<slug>")
    q.add_argument("--title", help="index.md のタイトル（省略時は slug）")
    q.set_defaults(fn=cmd_task_new)
    q = t.add_parser("use", help="現在のタスクを切り替える")
    q.add_argument("path", help="projects/<案件>/tasks/<タスク>")
    q.set_defaults(fn=cmd_task_use)
    t.add_parser("current", help="現在のタスクを表示する").set_defaults(fn=cmd_task_current)
    t.add_parser("done", help="現在のタスクを完了にし、現在のタスクを解除する").set_defaults(fn=cmd_task_done)

    r = sub.add_parser("ref", help="情報源").add_subparsers(dest="sub", required=True)
    q = r.add_parser("add", help="URL かファイルを現在のタスクの references/ に保存する")
    q.add_argument("source", help="URL かファイルパス")
    q.add_argument("--summary", help="1文の要約（index.md の一覧に出る）。省略すると空で保存し、後で埋める")
    q.add_argument("--title")
    q.add_argument("--kind", choices=REF_KINDS, help="省略時は URL なら web、ファイルなら file")
    q.add_argument("--dir", help="現在のタスクを使わず、このディレクトリに reference を書く（例: docs/ の根拠台帳）")
    q.add_argument("--force", action="store_true", help="同じ source の reference が既にあっても撮り直す")
    q.set_defaults(fn=cmd_ref_add)
    q = r.add_parser("split", help="旧形式（1 ファイル）の reference を要点＋<stem>.orig.md の対に分割する（冪等）")
    q.add_argument("file")
    q.set_defaults(fn=cmd_ref_split)

    tr = sub.add_parser("transcript", help="文字起こし").add_subparsers(dest="sub", required=True)
    q = tr.add_parser("normalize", help="用語集の誤変換を正式表記に置換した *.normalized.md を作る")
    q.add_argument("file")
    q.add_argument("--project", help="省略時はファイルの場所か現在のタスクから決める")
    q.set_defaults(fn=cmd_transcript_normalize)

    g = sub.add_parser("glossary", help="用語集").add_subparsers(dest="sub", required=True)
    q = g.add_parser("add", help="用語集に1行足す")
    q.add_argument("project")
    q.add_argument("term", help="正式表記")
    q.add_argument("--reading", help="よみ")
    q.add_argument("--alias", help="誤変換・別表記（カンマ区切り）")
    q.add_argument("--desc", help="説明")
    q.set_defaults(fn=cmd_glossary_add)

    k = sub.add_parser("know", help="ナレッジ").add_subparsers(dest="sub", required=True)
    q = k.add_parser("new", help="knowledges/NNN_<title>.md を雛形から作る")
    q.add_argument("project")
    q.add_argument("title")
    q.set_defaults(fn=cmd_know_new)

    q = sub.add_parser("index", help="index.md の自動生成部分（<!-- ws:index -->）を更新する")
    q.add_argument("dir", nargs="?", help="省略時は projects/ 以下すべて")
    q.set_defaults(fn=cmd_index)

    le = sub.add_parser("lesson", help="人からの指摘（教訓）").add_subparsers(dest="sub", required=True)
    q = le.add_parser("add", help="LESSONS.md に 1 行足す（--project なら案件の決まりごとへ）")
    q.add_argument("text", help="「〜のとき、〜する（理由）」の 1 行")
    q.add_argument("--project", help="案件固有の指摘はその案件の index.md の決まりごとへ")
    q.set_defaults(fn=cmd_lesson_add)

    sub.add_parser("doctor", help="index.md や frontmatter の欠落を報告する").set_defaults(fn=cmd_doctor)
    sub.add_parser("statusline", help="Claude Code の statusLine（stdin に JSON）。現在のタスク・文脈の使用率・費用を 1 行で出す").set_defaults(fn=cmd_statusline)

    h = sub.add_parser("hook", help="エージェントの hooks から呼ばれる（stdin に JSON）").add_subparsers(dest="sub", required=True)
    h.add_parser("session-start").set_defaults(fn=cmd_hook_session_start)
    h.add_parser("pre-tool-use").set_defaults(fn=cmd_hook_pre_tool_use)
    h.add_parser("post-tool-use").set_defaults(fn=cmd_hook_post_tool_use)
    q = h.add_parser("user-prompt-submit")
    q.add_argument("--ttl", type=int,
                    help="WS_CACHE_TTL_MIN 未設定時のキャッシュ TTL（分）。省略時 60（Codex は 30 を渡す）")
    q.set_defaults(fn=cmd_hook_user_prompt_submit)
    h.add_parser("stop").set_defaults(fn=cmd_hook_stop)

    args = ap.parse_args(argv)
    if args.cmd == "hook":
        try:
            args.fn(args)
        except Exception as e:  # noqa: BLE001 — hook が壊れても作業を止めない（fail-open）
            print(f"[agent-ws] hook error: {e}", file=sys.stderr)
        return
    args.fn(args)


if __name__ == "__main__":
    main()
